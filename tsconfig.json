{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["vitest/globals", "node"],
    // The examples import the package by its published specifier, exactly as a
    // consumer's code does — that is the point of them. These map that
    // specifier back to the source so `tsc` can resolve it in-repo, without the
    // examples having to import `../../src` and stop being copy-pasteable.
    "paths": {
      "@sarv-in/mailguard": ["./src/index.ts"],
      "@sarv-in/mailguard/verdict": ["./src/verdict.ts"],
      "@sarv-in/mailguard/identity": ["./src/identity.ts"],
      "@sarv-in/mailguard/links": ["./src/links.ts"],
      "@sarv-in/mailguard/security": ["./src/security.ts"],
      "@sarv-in/mailguard/age": ["./src/age.ts"]
    }
  },
  "include": ["src", "test", "examples"],
  "exclude": ["dist", "node_modules"]
}
